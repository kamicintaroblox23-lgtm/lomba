# Server
PORT=3000
HOST=0.0.0.0
# Isi dengan origin web yang dipakai, atau hapus baris ini untuk konfigurasi default.
# CORS_ORIGIN=http://192.168.0.17:3000

# Required for live marketplace search. Leave empty to use local fallback catalog.
SERPAPI_KEY=

# Optional: Google Gemini API for the working shopping assistant.
# Create/rotate this key in Google AI Studio; never commit it or put it in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Unsplash API access key for product-specific image fallback.
# Only the access key is needed for server-side photo search.
# Never put the Unsplash secret key in this project or in frontend code.
UNSPLASH_ACCESS_KEY=

SHOPEE_RAPIDAPI_HOST=shopee14.p.rapidapi.com
